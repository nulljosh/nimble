{
  "observability": { "enabled": true },
  "name": "nimble-answers",
  "main": "worker.js",
  "compatibility_date": "2025-07-01",
  "ai": { "binding": "AI" },
  // ponytail: native Cloudflare rate limiting instead of a hand-rolled Map --
  // the endpoint is public and every request bills Workers AI.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 60 }
      },
      {
        "name": "API_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 60, "period": 60 }
      }
    ]
  },
  // One global instance holds the day's /stats numbers (the Cache API is per data center). KV can't: 1,000 writes a day.
  "durable_objects": { "bindings": [{ "name": "COUNTS", "class_name": "NimbleCounts" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NimbleCounts"] }]
}
