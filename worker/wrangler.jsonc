{
  "observability": { "enabled": true },
  "name": "nimble-answers",
  "main": "worker.js",
  "compatibility_date": "2025-07-01",
  "ai": { "binding": "AI" },
  // ponytail: native Cloudflare rate limiting instead of a hand-rolled Map --
  // the endpoint is public and every request bills Workers AI.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 60 }
      }
    ]
  },
  // Not created yet. The daily neuron counter uses the Cache API (per data center, best effort).
  // For a global counter: `npx wrangler kv namespace create NIMBLE_KV`, then uncomment and paste the id it prints.
  // "kv_namespaces": [{ "binding": "NIMBLE_KV", "id": "<id from the command>" }]
}
