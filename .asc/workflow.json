{
  // Release automation. Run: asc workflow run ship-ios VERSION:1.0.0
  // iOS 1.0.0 was approved 2026-09-24, so SUBMIT:true is the normal path:
  //   asc workflow run ship-ios VERSION:2.0.0 SUBMIT:true
  "env": { "IOS_APP_ID": "6807858746", "VERSION": "2.0.0", "SUBMIT": "false" },
  "before_all": "asc auth status",
  "workflows": {
    "ship-ios": { "description": "Bump, archive, export, upload iOS", "steps": [
      { "name": "bump", "run": "asc xcode version edit --version \"$VERSION\" --build-number \"$(date +%Y%m%d%H%M)\"" },
      { "name": "archive", "run": "asc xcode archive --project Nimble.xcodeproj --scheme Nimble-iOS --archive-path .asc/artifacts/Nimble.xcarchive --overwrite --xcodebuild-flag=-skipPackagePluginValidation --output json" },
      { "name": "export", "run": "asc xcode export --archive-path .asc/artifacts/Nimble.xcarchive --export-options ExportOptions.plist --overwrite --ipa-path .asc/artifacts/Nimble.ipa --output json" },
      { "name": "publish", "if": "SUBMIT", "run": "asc publish appstore --app $IOS_APP_ID --ipa .asc/artifacts/Nimble.ipa --version $VERSION --wait --confirm --output json" }
    ] }
  }
}
