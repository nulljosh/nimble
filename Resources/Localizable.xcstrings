    "The free AI is out of answers for today, so this is from Wikipedia. It resets in the evening.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free AI is out of answers for today, so this is from Wikipedia. It resets in the evening."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA gratuite n'a plus de réponses pour aujourd'hui, donc ceci vient de Wikipédia. Elle se remet à zéro le soir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA gratuita se quedó sin respuestas por hoy, así que esto viene de Wikipedia. Se reinicia por la noche."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "免费 AI 今天的回答次数已用完，所以这条内容来自维基百科。傍晚会重置。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੁਫ਼ਤ AI ਅੱਜ ਲਈ ਜਵਾਬ ਖ਼ਤਮ ਕਰ ਚੁੱਕਾ ਹੈ, ਇਸ ਲਈ ਇਹ ਵਿਕੀਪੀਡੀਆ ਤੋਂ ਹੈ। ਸ਼ਾਮ ਨੂੰ ਇਹ ਮੁੜ ਸ਼ੁਰੂ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kostenlose KI hat für heute keine Antworten mehr, deshalb kommt das von Wikipedia. Am Abend geht es wieder los."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA gratuita ficou sem respostas por hoje, então isto vem da Wikipedia. Ela volta à noite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ़्त AI के आज के जवाब ख़त्म हो गए हैं, इसलिए यह Wikipedia से है। यह शाम को फिर से शुरू होगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料AIは今日の分の回答を使い切ったため、これはWikipediaからです。夜にまた使えるようになります。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA gratuita ha finito le risposte per oggi, quindi questa viene da Wikipedia. Si ricarica in serata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 무료 AI 답변을 모두 썼기 때문에 Wikipedia에서 가져왔습니다. 저녁에 초기화됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный ИИ на сегодня исчерпан, поэтому ответ из Wikipedia. Лимит обновится вечером."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gratis AI is op voor vandaag, dus dit komt van Wikipedia. Het wordt 's avonds weer aangevuld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz YZ'nin bugünkü yanıtları bitti, bu yüzden bu Wikipedia'dan. Akşam yenilenir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Darmowe AI wyczerpało dziś odpowiedzi, więc ta pochodzi z Wikipedii. Limit odnawia się wieczorem."
          }
        }
      }
    },
    "Not a direct answer to your question. Background from Wikipedia:": {
      "extractionState": "manual",
      "localizations": {
        "en": {
