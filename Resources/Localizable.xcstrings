    "Math, units and graphs work offline. Everything else gets one sentence and a source.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Math, units and graphs work offline. Everything else gets one sentence and a source."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculs, unités et graphiques fonctionnent hors ligne. Le reste tient en une phrase, avec sa source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas, unidades y gráficas funcionan sin conexión. Lo demás recibe una frase y su fuente."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "数学、单位换算和图表可离线使用。其他问题给你一句话和出处。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਿਸਾਬ, ਇਕਾਈਆਂ ਅਤੇ ਗ੍ਰਾਫ਼ ਬਿਨਾਂ ਇੰਟਰਨੈੱਟ ਦੇ ਚੱਲਦੇ ਹਨ। ਬਾਕੀ ਸਭ ਲਈ ਇੱਕ ਵਾਕ ਅਤੇ ਇੱਕ ਸਰੋਤ ਮਿਲਦਾ ਹੈ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechnen, Einheiten und Diagramme funktionieren offline. Alles andere bekommt einen Satz und eine Quelle."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas, unidades e gráficos funcionam offline. O resto ganha uma frase e uma fonte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गणित, इकाइयाँ और ग्राफ़ ऑफ़लाइन चलते हैं। बाकी हर चीज़ का एक वाक्य और एक स्रोत मिलता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算、単位、グラフはオフラインで使えます。それ以外は一文と情報源でお答えします。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Matematica, unità e grafici funzionano offline. Tutto il resto riceve una frase e una fonte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수학, 단위, 그래프는 오프라인에서 작동합니다. 나머지는 한 문장과 출처로 답합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Математика, единицы и графики работают офлайн. На всё остальное — одно предложение и источник."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekenen, eenheden en grafieken werken offline. Al het andere krijgt één zin en een bron."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Matematik, birimler ve grafikler çevrimdışı çalışır. Geri kalan her şey bir cümle ve bir kaynakla yanıtlanır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Matematyka, jednostki i wykresy działają offline. Na resztę odpowiedź to jedno zdanie i źródło."
          }
        }
      }
    },
