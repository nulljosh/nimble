        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਰੰਤ ਜਵਾਬ ਨਹੀਂ ਮਿਲਿਆ। ਕੋਈ ਸਵਾਲ, ਜੋੜ, ਜਾਂ \"5 miles to km\" ਅਜ਼ਮਾਓ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine sofortige Antwort. Probier eine Frage, eine Rechnung oder „5 miles to km“."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem resposta imediata. Tente uma pergunta, uma conta ou \"5 miles to km\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुरंत जवाब नहीं मिला। कोई सवाल, जोड़-घटाव या \"5 miles to km\" आज़माएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐには答えられません。質問や計算、「5 miles to km」を試してください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna risposta immediata. Prova una domanda, un calcolo o \"5 miglia in km\"."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바로 답할 수 없습니다. 질문, 계산 또는 \"5 miles to km\"를 입력해 보세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет мгновенного ответа. Попробуйте вопрос, пример или «5 миль в км»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen direct antwoord. Probeer een vraag, een som of \"5 mijl naar km\"."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anında yanıt yok. Bir soru, bir işlem ya da \"5 mil kaç km\" dene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak natychmiastowej odpowiedzi. Spróbuj pytania, działania albo \"5 mil na km\"."
          }
        }
      }
    },
