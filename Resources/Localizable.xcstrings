        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell eine Frage. Bekomm einen Satz zurück."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pergunta. Receba uma frase."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सवाल पूछिए। एक वाक्य में जवाब पाइए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問すると、一文で答えが返ります。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una domanda. Ricevi una frase."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문하세요. 한 문장으로 답합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте вопрос. Получите одно предложение."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een vraag. Krijg één zin terug."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir soru sor. Tek cümlelik yanıt al."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj pytanie. Dostań jedno zdanie."
          }
        }
      }
    },
    "Math and units answer on your device. Everything else, one sentence with a source.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Math and units answer on your device. Everything else, one sentence with a source."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calculs et les unités se font sur votre appareil. Le reste, une phrase avec sa source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas y unidades se resuelven en tu dispositivo. Lo demás, una frase con su fuente."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "数学和单位换算在你的设备上完成。其他问题，给你一句带出处的话。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਿਸਾਬ ਅਤੇ ਇਕਾਈਆਂ ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਉੱਤੇ ਹੱਲ ਹੁੰਦੇ ਹਨ। ਬਾਕੀ ਸਭ ਲਈ ਸਰੋਤ ਸਮੇਤ ਇੱਕ ਵਾਕ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechnen und Einheiten laufen auf deinem Gerät. Alles andere: ein Satz mit Quelle."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas e unidades são respondidas no seu aparelho. O resto, uma frase com fonte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गणित और इकाइयाँ आपके डिवाइस पर ही हल होती हैं। बाकी सब, एक वाक्य और एक स्रोत।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算と単位は端末の中で答えます。それ以外は、情報源つきの一文で。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Matematica e unità rispondono sul tuo dispositivo. Tutto il resto, una frase con una fonte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수학과 단위는 기기에서 답합니다. 나머지는 출처와 함께 한 문장으로."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Математика и единицы считаются на вашем устройстве. Всё остальное — одно предложение с источником."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekenen en eenheden antwoorden op je apparaat. Al het andere, één zin met een bron."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Matematik ve birimler cihazında yanıtlanır. Geri kalan her şey, kaynaklı tek cümle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Matematyka i jednostki liczą się na Twoim urządzeniu. Reszta to jedno zdanie ze źródłem."
          }
        }
      }
    },
