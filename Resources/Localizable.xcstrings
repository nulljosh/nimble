    "You're offline. Math, units and graphs still work.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. Math, units and graphs still work."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Les calculs, unités et graphiques fonctionnent toujours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Las cuentas, unidades y gráficas siguen funcionando."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
