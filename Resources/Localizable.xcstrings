    "Ask a question. Get one sentence back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question. Get one sentence back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question. Recevez une phrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pregunta. Recibe una frase."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "提个问题，得到一句话。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਵਾਲ ਪੁੱਛੋ। ਇੱਕ ਵਾਕ ਵਿੱਚ ਜਵਾਬ ਲਵੋ।"
