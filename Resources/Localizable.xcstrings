            "state": "translated",
            "value": "Votre clé reste sur cet appareil et n'est envoyée qu'à %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave se queda en este dispositivo y solo se envía a %@."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的密钥保存在此设备上，只会发送给 %@。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਕੁੰਜੀ ਇਸ ਡਿਵਾਈਸ ਉੱਤੇ ਹੀ ਰਹਿੰਦੀ ਹੈ ਅਤੇ ਸਿਰਫ਼ %@ ਨੂੰ ਭੇਜੀ ਜਾਂਦੀ ਹੈ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Schlüssel bleibt auf diesem Gerät und wird nur an %@ gesendet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave fica neste aparelho e só é enviada para %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कुंजी इसी डिवाइस पर रहती है और सिर्फ़ %@ को भेजी जाती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはこの端末に残り、%@にだけ送られます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave resta su questo dispositivo e viene inviata solo a %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 이 기기에 남아 있고 %@에만 전송됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ остаётся на этом устройстве и отправляется только в %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je sleutel blijft op dit apparaat en gaat alleen naar %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarın bu cihazda kalır ve yalnızca %@ hizmetine gönderilir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój klucz zostaje na tym urządzeniu i trafia tylko do %@."
          }
        }
      }
    },
    "Asks this again": {
      "extractionState": "manual",
      "localizations": {
