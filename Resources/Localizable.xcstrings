    "Not in the offline pack. Math, units and graphs still work offline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not in the offline pack. Math, units and graphs still work offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absent du pack hors ligne. Les calculs, unités et graphiques marchent toujours hors ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No está en el paquete sin conexión. Las matemáticas, unidades y gráficos siguen funcionando sin conexión."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "不在离线包中。数学、单位和图表离线仍可使用。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Not in the offline pack. Math, units and graphs still work offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht im Offline-Paket. Rechnen, Einheiten und Diagramme funktionieren offline weiter."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não está no pacote offline. Contas, unidades e gráficos continuam funcionando offline."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन पैक में नहीं है। गणित, इकाइयाँ और ग्राफ़ ऑफ़लाइन फिर भी चलते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインパックにありません。計算、単位、グラフはオフラインでも使えます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è nel pacchetto offline. Matematica, unità e grafici funzionano ancora offline."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 팩에 없습니다. 수학, 단위, 그래프는 오프라인에서도 작동합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет в офлайн-пакете. Математика, единицы и графики работают офлайн."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet in het offline pakket. Rekenen, eenheden en grafieken werken nog offline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı pakette yok. Matematik, birimler ve grafikler çevrimdışı çalışmaya devam eder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma tego w pakiecie offline. Matematyka, jednostki i wykresy nadal działają offline."
          }
        }
