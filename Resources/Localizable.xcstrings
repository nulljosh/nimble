    "You're offline. Math, units and graphs still work.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. Math, units and graphs still work."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Les calculs, unités et graphiques fonctionnent toujours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Las cuentas, unidades y gráficas siguen funcionando."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你已离线。数学、单位换算和图表仍可使用。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਔਫ਼ਲਾਈਨ ਹੋ। ਹਿਸਾਬ, ਇਕਾਈਆਂ ਅਤੇ ਗ੍ਰਾਫ਼ ਹਾਲੇ ਵੀ ਚੱਲਦੇ ਹਨ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Rechnen, Einheiten und Diagramme funktionieren weiter."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. Contas, unidades e gráficos continuam funcionando."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। गणित, इकाइयाँ और ग्राफ़ फिर भी चलते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。計算、単位、グラフは使えます。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. Matematica, unità e grafici funzionano ancora."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태입니다. 수학, 단위, 그래프는 계속 작동합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет сети. Математика, единицы и графики по-прежнему работают."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent offline. Rekenen, eenheden en grafieken werken nog."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısın. Matematik, birimler ve grafikler çalışmaya devam eder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś offline. Matematyka, jednostki i wykresy nadal działają."
          }
        }
      }
    },
    "No instant answer. Try a question, a sum, or \"5 miles to km\".": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No instant answer. Try a question, a sum, or \"5 miles to km\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de réponse instantanée. Essayez une question, un calcul ou \"5 miles to km\"."
          }
        },
        "es": {
