            "state": "translated",
            "value": "オフラインパックをダウンロードできませんでした。接続のある場所でもう一度お試しください。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scaricare il pacchetto offline. Riprova con una connessione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 팩을 다운로드할 수 없습니다. 연결된 상태에서 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось скачать офлайн-пакет. Попробуйте снова при подключении к сети."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan het offline pakket niet downloaden. Probeer het opnieuw met een verbinding."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı paket indirilemedi. Bağlantı varken yeniden dene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się pobrać pakietu offline. Spróbuj ponownie z połączeniem."
          }
        }
      }
    },
