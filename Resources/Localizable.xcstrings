    "Nothing leaves this device. Click to turn private mode off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing leaves this device. Click to turn private mode off"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne quitte cet appareil. Cliquez pour désactiver le mode privé"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada sale de este dispositivo. Haz clic para desactivar el modo privado"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没有任何内容离开此设备。点击关闭隐私模式"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing leaves this device. Click to turn private mode off"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verlässt dieses Gerät. Klicken, um den privaten Modus auszuschalten"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada sai deste aparelho. Clique para desligar o modo privado"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी इस डिवाइस से बाहर नहीं जाता। निजी मोड बंद करने के लिए क्लिक करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末の外には何も出ません。クリックでプライベートモードをオフ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla lascia questo dispositivo. Fai clic per disattivare la modalità privata"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기 밖으로 아무것도 나가지 않습니다. 클릭하면 비공개 모드가 꺼집니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не покидает это устройство. Нажмите, чтобы выключить приватный режим"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets verlaat dit apparaat. Klik om privémodus uit te zetten"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey bu cihazdan çıkmaz. Gizli modu kapatmak için tıkla"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie opuszcza tego urządzenia. Kliknij, aby wyłączyć tryb prywatny"
          }
        }
      }
    },
