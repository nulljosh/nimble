    "Ask a question. Get one sentence back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question. Get one sentence back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question. Recevez une phrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pregunta. Recibe una frase."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "提个问题，得到一句话。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਵਾਲ ਪੁੱਛੋ। ਇੱਕ ਵਾਕ ਵਿੱਚ ਜਵਾਬ ਲਵੋ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell eine Frage. Bekomm einen Satz zurück."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pergunta. Receba uma frase."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सवाल पूछिए। एक वाक्य में जवाब पाइए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問すると、一文で答えが返ります。"
          }
        }
      }
    },
    "Math and units answer on your device. Everything else, one sentence with a source.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Math and units answer on your device. Everything else, one sentence with a source."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calculs et les unités se font sur votre appareil. Le reste, une phrase avec sa source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas y unidades se resuelven en tu dispositivo. Lo demás, una frase con su fuente."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "数学和单位换算在你的设备上完成。其他问题，给你一句带出处的话。"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਿਸਾਬ ਅਤੇ ਇਕਾਈਆਂ ਤੁਹਾਡੇ ਡਿਵਾਈਸ ਉੱਤੇ ਹੱਲ ਹੁੰਦੇ ਹਨ। ਬਾਕੀ ਸਭ ਲਈ ਸਰੋਤ ਸਮੇਤ ਇੱਕ ਵਾਕ।"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechnen und Einheiten laufen auf deinem Gerät. Alles andere: ein Satz mit Quelle."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Contas e unidades são respondidas no seu aparelho. O resto, uma frase com fonte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गणित और इकाइयाँ आपके डिवाइस पर ही हल होती हैं। बाकी सब, एक वाक्य और एक स्रोत।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算と単位は端末の中で答えます。それ以外は、情報源つきの一文で。"
          }
        }
      }
    },
