{
  "manifest_version": 3,
  "name": "Nimble",
  "version": "6.16.0",
  "description": "Select text or press Alt+N, get the one-sentence answer.",
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://nimble.jaybulb.com/*"],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+N" }, "description": "Ask Nimble" } },
  "browser_specific_settings": { "gecko": { "id": "nimble@jaybulb.com" } }
}
